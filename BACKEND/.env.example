# V2V Fleet Control backend settings.
#
# Copy this file to BACKEND/.env and fill in your values.
# .env is ignored by git. Never commit real credentials.
# Environment variables override values in .env. Names are
# case-insensitive. Invalid values stop the backend at startup.
# All settings are defined in services/settings.py.

# ---- ThingsBoard -------------------------------------------------
THINGSBOARD_URL=https://thingsboard.cloud
THINGSBOARD_USERNAME=you@example.com
THINGSBOARD_PASSWORD=change-me

# TLS verification for ThingsBoard (on by default).
# THINGSBOARD_TRUST_STORE=system verifies against the Windows
# certificate store, which holds the corporate root certificate
# a TLS-intercepting company network needs. Use certifi for the
# public CA bundle only, or point THINGSBOARD_CA_BUNDLE at an
# exported PEM file (it overrides the trust store).
THINGSBOARD_VERIFY_TLS=true
THINGSBOARD_TRUST_STORE=system
THINGSBOARD_CA_BUNDLE=

# ---- Fleet registry ----------------------------------------------
# Default: BACKEND/data/vehicles.json (holds device tokens; ignored by git).
FLEET_DATA_FILE=

# ---- HTTP server and access --------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
# Restart the server when a .py file changes (development only).
DEV_RELOAD=false
# Browser origins allowed to call the API: comma-separated, or *.
# Empty = the dashboard opened from disk, and localhost on any port.
CORS_ORIGINS=
# Allow vehicle add/edit/delete from other computers.
ALLOW_REMOTE_FLEET_ADMIN=false

# ---- World model and simulation ------------------------------------
# Who owns vehicle state: backend (default; ThingsBoard only receives
# it) or thingsboard_mirror (old behaviour: read state back from
# ThingsBoard, for an external device writing telemetry there).
STATE_SOURCE=backend
# Route map. Default: BACKEND/config/world.json
WORLD_FILE=
# World engine step in ms (vehicle motion). 0 turns motion off.
WORLD_TICK_MS=200
# Seed for all simulated randomness (repeatable runs).
SIM_SEED=1234

# ---- Safety ------------------------------------------------------
# Demo override: treat the AprilTag/QR marker as always detected,
# so the QR interlock never blocks START or loading.
QR_ALWAYS_DETECTED=false

# ---- Commands ----------------------------------------------------
# Seconds a command waits for another command on the same vehicle
# before failing with 409 COMMAND_IN_PROGRESS.
COMMAND_LOCK_TIMEOUT_S=20
# Seconds a response is kept for replay under its Idempotency-Key
# header (0 turns the feature off).
IDEMPOTENCY_TTL_S=600

# ---- V2V message bus (starting values; POST /api/v1/v2v/config
#      changes them while the backend runs) ------------------------
V2V_COMM_RANGE_M=150
V2V_LOSS_RATE=0.02
V2V_LATENCY_MIN_MS=20
V2V_LATENCY_MAX_MS=80
# The roadside unit relays messages between distant vehicles and
# manages the loading-point slot.
V2V_RSU_ENABLED=true
V2V_CAM_INTERVAL_MS=500
# A vehicle in range not heard for this long is LOST (fail-safe).
V2V_CAM_TIMEOUT_MS=1500
V2V_HANDOVER_TIMEOUT_MS=2000
V2V_TARGET_GAP_M=25

# ---- Autopilot (Phase 4) -------------------------------------------
# Every vehicle starts in MANUAL after each backend start; turn the
# autopilot on with POST /api/v1/autopilot/enable.
# handover = one vehicle cycles at a time, next one after a V2V
# handover at Stop 3; concurrent = every AUTO vehicle cycles.
AUTOPILOT_DISPATCH=handover
AUTOPILOT_CRUISE_KMH=18
AUTOPILOT_DEPART_HEADWAY_S=10
# Gap to the vehicle ahead: slow down below MIN, emergency brake below CRITICAL.
MIN_GAP_M=10
CRITICAL_GAP_M=4
HAZARD_STANDOFF_M=8
SLOT_HOLD_M=12
RADAR_RANGE_M=20
LOADING_RATE_PCT_PER_S=10
UNLOADING_RATE_PCT_PER_S=20
# Fleet emergency stop if the tick loop stalls this long (while any vehicle is AUTO).
WATCHDOG_MS=1000
# Simulation speed, 0.25 to 8 (POST /api/v1/autopilot/time-scale changes it live).
TIME_SCALE=1

# ---- Battery model ---------------------------------------------------
BATTERY_DRAIN_PCT_PER_KM=15
BATTERY_IDLE_DRAIN_PCT_PER_MIN=0.5
BATTERY_CHARGE_PCT_PER_S=2
BATTERY_LOW_PCT=20
BATTERY_CHARGE_TARGET_PCT=95
